{
  "name": "travel-sim",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "preview": "vite preview",
    "bake": "tsx scripts/bake/index.ts",
    "bake:flight": "tsx scripts/bake/flight.ts",
    "audio": "tsx scripts/audio/build.ts",
    "deploy": "npm run build && npx wrangler@4 pages deploy dist --project-name travel-sim --branch main"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "geotiff": "^3.0.5",
    "meshoptimizer": "^1.3.0",
    "osm-pbf-parser-node": "^1.1.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  }
}
